# Puerto del servidor
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=enrec
DB_PASSWORD=cambiar_esto
DB_NAME=enrec

# Admin — token para acceder a /api/admin/postulaciones
ADMIN_TOKEN=cambiar_esto_en_produccion

# YouTube API — para verificar suscripciones
# Obtener en: console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=
# ID del canal EN .REC (conseguirlo en YouTube Studio → Configuración → Canal → Información básica)
ENREC_CHANNEL_ID=

# Email (nodemailer) — si SMTP_HOST está vacío, se omite el envío de emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=radar@enrec.com.ar
FROM_NAME=EN .REC
NOTIFY_EMAIL=clari.presas@gmail.com
